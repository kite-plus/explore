# Copy to .env next to docker-compose.yaml and fill in.
# docs/design/project-layout.md section 4 describes every variable.

# The release to run, such as 0.1.0; latest follows the newest release.
EXPLORE_VERSION=latest

POSTGRES_PASSWORD=

# Where readers reach the site. Caddy gets the HTTPS certificate for this
# host, so its DNS record has to point at the server first.
EXPLORE_PUBLIC_URL=https://explore.kite.plus

# Addresses allowed to set X-Forwarded-For. Empty means the compose network
# (10.89.0.0/24), which covers Caddy, the web service and the host's port
# mapping.
EXPLORE_TRUSTED_PROXIES=

# The address ranges of a CDN in front of Caddy, separated by spaces, so rate
# limits count readers rather than the CDN; docs/design/project-layout.md
# section 10 explains. Behind Cloudflare, uncomment this line, which lists
# its ranges from https://www.cloudflare.com/ips/ as of October 2026:
# EXPLORE_CDN_RANGES=173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
EXPLORE_CDN_RANGES=

# Search engine site verification, shown as meta tags by the web service.
EXPLORE_SITE_VERIFICATION_BAIDU=
EXPLORE_SITE_VERIFICATION_GOOGLE=

# Tagging posts with a model; an empty model switches it off. The provider is
# "anthropic" or "openai", the latter meaning any OpenAI-compatible chat
# completions API such as OpenAI, DeepSeek or a local model server. The base
# URL defaults to the provider's own; for "openai" it ends before
# /chat/completions, such as https://api.deepseek.com. Only an "openai" base
# URL that needs no key may leave the key empty. Effort and the extra body, a
# JSON object of request fields such as '{"thinking":{"type":"disabled"}}'
# for DeepSeek, are optional; see docs/design/project-layout.md section 4.
EXPLORE_TAGGER_PROVIDER=anthropic
EXPLORE_TAGGER_BASE_URL=
EXPLORE_TAGGER_MODEL=
EXPLORE_TAGGER_API_KEY=
EXPLORE_TAGGER_EFFORT=
EXPLORE_TAGGER_EXTRA_BODY=

EXPLORE_WORKER_CONCURRENCY=16
EXPLORE_LOG_LEVEL=info
