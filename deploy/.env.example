# Copy to deploy/.env and fill in. docs/design/project-layout.md section 4
# describes every variable.

POSTGRES_PASSWORD=

EXPLORE_PUBLIC_URL=https://explore.kite.plus

# Maintainers, as name:sha256-of-token pairs separated by commas. Generate a
# hash with: printf %s "$TOKEN" | shasum -a 256
# Leave empty to switch the admin API off.
EXPLORE_ADMIN_TOKENS=

# The reverse proxy, and later the web service, so rate limits see readers'
# real addresses.
EXPLORE_TRUSTED_PROXIES=

EXPLORE_WORKER_CONCURRENCY=16
EXPLORE_LOG_LEVEL=info
