# Copy to .env next to docker-compose.yaml and fill in.
# docs/design/project-layout.md section 4 describes every variable.

# The release to run, such as 0.1.0; latest follows the newest release.
EXPLORE_VERSION=latest

POSTGRES_PASSWORD=

# Where readers reach the site. Caddy gets the HTTPS certificate for this
# host, so its DNS record has to point at the server first.
EXPLORE_PUBLIC_URL=https://explore.kite.plus

# Addresses allowed to set X-Forwarded-For. Empty means the compose network
# (10.89.0.0/24), which covers Caddy, the web service and the host's port
# mapping.
EXPLORE_TRUSTED_PROXIES=

# Search engine site verification, shown as meta tags by the web service.
EXPLORE_SITE_VERIFICATION_BAIDU=
EXPLORE_SITE_VERIFICATION_GOOGLE=

# Tagging posts with a Claude model. Set the model and the key together, or
# leave both empty to switch tagging off; docs/design/accounts.md section 5.3
# compares models and their cost. Effort is optional: "low" suits Claude
# Opus 5 and Claude Sonnet 5; leave it empty for Claude Haiku 4.5, which
# rejects it.
EXPLORE_TAGGER_MODEL=
EXPLORE_ANTHROPIC_API_KEY=
EXPLORE_TAGGER_EFFORT=

EXPLORE_WORKER_CONCURRENCY=16
EXPLORE_LOG_LEVEL=info
