---
import { avatarColor, initial } from "@/lib/avatar";
import { cn } from "@/lib/utils";

interface Props {
  host: string;
  name: string;
  size?: "sm" | "md" | "lg";
}

const { host, name, size = "sm" } = Astro.props;
---

<span
  aria-hidden="true"
  class={cn(
    "group/avatar relative inline-flex shrink-0 items-center justify-center overflow-hidden rounded-full font-medium text-white",
    avatarColor(host),
    { sm: "size-5 text-[0.65rem]", md: "size-8 text-sm", lg: "size-12 text-xl" }[size],
  )}
>
  <span class="group-[.has-favicon]/avatar:hidden">{initial(name)}</span>
  <img
    src={`/api/v1/blogs/${encodeURIComponent(host)}/favicon`}
    alt=""
    loading="lazy"
    decoding="async"
    data-blog-favicon
    class={cn(
      "absolute inset-0 size-full object-contain group-[.has-favicon]/avatar:bg-white",
      size === "sm" ? "p-0.5" : "p-1",
    )}
  />
</span>
