---
import { avatarColor, initial } from "@/lib/avatar";
import { cn } from "@/lib/utils";

interface Props {
  host: string;
  name: string;
  size?: "sm" | "lg";
}

const { host, name, size = "sm" } = Astro.props;
const large = size === "lg";
---

<span
  aria-hidden="true"
  class={cn(
    "relative inline-flex shrink-0 items-center justify-center overflow-hidden rounded-full font-medium text-white",
    avatarColor(host),
    large ? "size-12 text-xl" : "size-5 text-[0.65rem]",
  )}
>
  {initial(name)}
  {large && <img src={`/api/v1/blogs/${encodeURIComponent(host)}/favicon`} alt="" loading="lazy" decoding="async" class="absolute inset-0 size-full object-contain" />}
</span>
