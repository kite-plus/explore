---
import { Pin } from "lucide-react";
import ExternalLink from "@/components/ExternalLink.astro";
import Logo from "@/components/Logo.astro";
import { dict, localePath, type Lang } from "@/i18n";
import { avatarColor, initial } from "@/lib/avatar";
import { withSource } from "@/lib/config";
import type { Notice } from "@/lib/types";
import { cn } from "@/lib/utils";

interface Props {
  lang: Lang;
  notice: Notice;
}

// A notice or ad in a stream, laid out as a post is, with a mark where a
// post gives its time: a warm capsule for a notice, an outlined one for an
// ad, and a pin when it leads the stream (docs/design/notices.md section 2).
const { lang, notice } = Astro.props;
const t = dict(lang);
const ad = notice.kind === "ad";
const pinned = notice.position === 0;
const href = notice.url ? (ad ? withSource(notice.url) : notice.url) : localePath(lang, `/notices/${notice.id}`);
---

<article class="flex gap-4 border-b py-4" data-notice={notice.id}>
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground">
      <span class="inline-flex min-w-0 items-center gap-1.5 font-medium text-foreground/80">
        {
          ad ? (
            <span
              aria-hidden="true"
              class={cn("inline-flex size-5 shrink-0 items-center justify-center rounded-full text-[0.65rem] font-medium text-white", avatarColor(notice.source_name))}
            >
              {initial(notice.source_name)}
            </span>
          ) : (
            <span aria-hidden="true" class="inline-flex size-5 shrink-0 items-center justify-center rounded-full border bg-white">
              <Logo class="h-3 w-auto" />
            </span>
          )
        }
        <span class="truncate">{notice.source_name}</span>
      </span>
      <span aria-hidden="true">·</span>
      <span
        class={cn(
          "inline-flex items-center gap-0.5 rounded-full px-1.5 py-px text-[0.6875rem] leading-4 font-medium",
          ad ? "border border-border text-muted-foreground" : "bg-warning/12 text-warning",
        )}
      >
        {pinned && <Pin className="size-3" aria-hidden="true" />}
        {pinned && <span class="sr-only">{t.notices.pinned}</span>}
        {ad ? t.notices.ad : t.notices.notice}
      </span>
    </div>
    <h3 class="mt-1.5 text-[0.9375rem] leading-snug font-semibold sm:text-base">
      {
        notice.url ? (
          <ExternalLink lang={lang} href={href} class="hover:underline">{notice.title}</ExternalLink>
        ) : (
          <a href={href} class="hover:underline">{notice.title}</a>
        )
      }
    </h3>
    {notice.summary && <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-muted-foreground">{notice.summary}</p>}
  </div>
</article>
