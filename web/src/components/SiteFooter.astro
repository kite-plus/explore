---
import { dict, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
}

const t = dict(Astro.props.lang).footer;
---

<footer class="border-t">
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-3 px-4 py-6 text-sm text-muted-foreground sm:px-6">
    <p>{t.note}</p>
    <nav class="flex flex-wrap gap-x-4 gap-y-1">
      <a href="/feed.xml" class="hover:text-foreground">{t.feed}</a>
      <a href="/blogs.opml" class="hover:text-foreground">{t.opml}</a>
      <a href="/bot" class="hover:text-foreground">{t.bot}</a>
      <a href="https://github.com/kite-plus/explore" class="hover:text-foreground">{t.source}</a>
    </nav>
  </div>
</footer>
