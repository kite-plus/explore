---
import { dict, localePath, type Lang } from "@/i18n";
import { withQuery } from "@/lib/utils";

type Stream = "latest" | "recommended" | "following";

interface Props {
  lang: Lang;
  current: Stream;
  // The current stream's filters, which its own tab keeps.
  query?: Record<string, string | undefined>;
}

// The tabs fill the toolbar's height, so the underline marks its bottom
// line. A screen too narrow for all three scrolls them sideways.
const { lang, current, query = {} } = Astro.props;
const t = dict(lang);
const tabs: { id: Stream; path: string; label: string }[] = [
  { id: "latest", path: "/", label: t.home.latest },
  { id: "recommended", path: "/recommended", label: t.home.recommended },
  { id: "following", path: "/following", label: t.home.subscriptions },
];
---

<nav aria-label={t.home.feedLabel} class="flex min-w-0 items-stretch gap-5 overflow-x-auto [scrollbar-width:none] sm:gap-6">
  {
    tabs.map((tab) => (
      <a
        href={tab.id === current ? withQuery(localePath(lang, tab.path), query) : localePath(lang, tab.path)}
        aria-current={tab.id === current ? "page" : undefined}
        class="flex shrink-0 items-center border-y-2 border-transparent text-sm whitespace-nowrap text-muted-foreground -outline-offset-2 hover:text-foreground aria-[current=page]:border-b-foreground aria-[current=page]:font-semibold aria-[current=page]:text-foreground"
        data-swap
      >
        {tab.label}
      </a>
    ))
  }
</nav>
