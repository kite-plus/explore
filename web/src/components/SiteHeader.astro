---
import Logo from "@/components/Logo.astro";
import { AccountMenu } from "@/components/reader/AccountMenu";

import { dict, localePath, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
  path: string;
  wide?: boolean;
}

const { lang, path, wide = false } = Astro.props;
const t = dict(lang);
// The three post streams are tabs on their pages (StreamTabs), so one item
// stands for all of them.
const links = [
  { href: localePath(lang, "/"), label: t.nav.home, current: ["/", "/recommended", "/following"].includes(path) },
  { href: localePath(lang, "/blogs"), label: t.nav.blogs, current: path.startsWith("/blogs") },
  { href: localePath(lang, "/submit"), label: t.nav.submit, current: path === "/submit" },
  { href: localePath(lang, "/about"), label: t.nav.about, current: path === "/about" },
];
---

<header class="border-b">
  <div class:list={["mx-auto flex w-full flex-wrap items-center gap-x-4 gap-y-4 px-4 py-4 sm:gap-x-6 sm:gap-y-2 sm:px-6", wide ? "max-w-6xl" : "max-w-3xl"]}>
    <a href={localePath(lang, "/")} class="mr-auto inline-flex items-center gap-2 text-lg font-semibold tracking-tight sm:mr-0">
      <Logo class="h-6 w-auto" />
      <span>Explore</span>
    </a>
    <nav class="order-last flex w-full flex-none flex-wrap items-center gap-x-4 gap-y-2 text-sm sm:order-none sm:w-auto sm:flex-1">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={l.current ? "page" : undefined}
            class="text-muted-foreground hover:text-foreground aria-[current=page]:font-medium aria-[current=page]:text-foreground"
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <AccountMenu client:load lang={lang} reader={Astro.locals.reader ?? null} checked={Astro.locals.readerChecked ?? false} />
  </div>
</header>
