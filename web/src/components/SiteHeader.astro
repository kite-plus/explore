---
import { CirclePlus, Compass, Info, Library, Menu, Monitor, Moon, Search, Sun, X } from "lucide-react";

import Logo from "@/components/Logo.astro";
import { AccountMenu } from "@/components/reader/AccountMenu";

import { dict, localePath, type Lang } from "@/i18n";
import { forwardedFor } from "@/lib/forwarded";
import { MAX_SEARCH_LENGTH } from "@/lib/loaders";
import { signInHref, signInOptions } from "@/lib/sign-in";

interface Props {
  lang: Lang;
  path: string;
  wide?: boolean;
}

// Held at the top of the window on every page. Its height is fixed because
// the stream toolbar sticks right under it (top-14) and global.css keeps
// anchors clear of it. Narrow screens fold the links into a menu.
const { lang, path, wide = false } = Astro.props;
const t = dict(lang);
// Sign in comes back to this page; with Kite Plus the only way in, the link
// goes straight to it.
const options = Astro.locals.reader ? undefined : await signInOptions({ lang, forwardedFor: forwardedFor(Astro.request, Astro.clientAddress) });
const signIn = signInHref(options, localePath(lang, "/login"), Astro.url.pathname + Astro.url.search);
// The three post streams are tabs on their pages (StreamTabs), so one item
// stands for all of them.
const links = [
  { href: localePath(lang, "/"), label: t.nav.home, icon: Compass, current: ["/", "/recommended", "/following"].includes(path) },
  { href: localePath(lang, "/blogs"), label: t.nav.blogs, icon: Library, current: path.startsWith("/blogs") },
  { href: localePath(lang, "/submit"), label: t.nav.submit, icon: CirclePlus, current: path === "/submit" },
  { href: localePath(lang, "/about"), label: t.nav.about, icon: Info, current: path === "/about" },
];
// A search field from medium widths up, which gives way before the links
// do; narrower screens, and the search page, which has its own field, show
// a button to the page instead.
const onSearch = path === "/search";
const searchPath = localePath(lang, "/search");
---

<header class="sticky top-0 z-30 h-14 border-b bg-background/85 backdrop-blur-md">
  <div class:list={["mx-auto flex h-full w-full items-center gap-6 px-4 sm:px-6", wide ? "max-w-6xl" : "max-w-3xl"]}>
    <a href={localePath(lang, "/")} class="inline-flex shrink-0 items-center gap-2">
      <Logo class="h-6 w-auto" />
      <span class="font-serif text-lg font-bold tracking-wide">Explore</span>
    </a>
    <nav aria-label={t.nav.label} class="hidden flex-1 items-center gap-6 text-sm sm:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={l.current ? "page" : undefined}
            class="whitespace-nowrap text-muted-foreground hover:text-foreground aria-[current=page]:font-medium aria-[current=page]:text-foreground"
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="ml-auto flex min-w-0 items-center gap-1.5 sm:ml-0">
      {
        !onSearch && (
          <form role="search" action={searchPath} method="get" class:list={["mr-1 hidden min-w-0 md:block", wide ? "w-60" : "w-44"]}>
            <label class="flex h-9 items-center gap-2 rounded-lg border bg-card/70 px-2.5 text-[0.8125rem] text-faint transition-colors focus-within:border-ring focus-within:bg-card hover:border-input">
              <Search className="size-[0.9375rem] shrink-0" aria-hidden="true" />
              <span class="sr-only">{t.search.label}</span>
              <input
                type="search"
                name="q"
                maxlength={MAX_SEARCH_LENGTH}
                placeholder={t.search.headerPlaceholder}
                autocomplete="off"
                enterkeyhint="search"
                data-header-search
                class="min-w-0 flex-1 bg-transparent text-foreground outline-none placeholder:text-faint [&::-webkit-search-cancel-button]:appearance-none"
              />
              <kbd aria-hidden="true" class="hidden rounded-[5px] border border-b-2 bg-background px-1.5 py-0.5 font-mono text-[0.6875rem] leading-none text-muted-foreground lg:inline">/</kbd>
            </label>
          </form>
        )
      }
      <a
        href={searchPath}
        aria-label={t.nav.search}
        title={t.nav.search}
        aria-current={onSearch ? "page" : undefined}
        class:list={[
          "size-9 items-center justify-center rounded-lg text-muted-foreground outline-offset-2 transition hover:bg-accent hover:text-foreground aria-[current=page]:bg-accent aria-[current=page]:text-foreground",
          onSearch ? "inline-flex" : "inline-flex md:hidden",
        ]}
      >
        <Search className="size-[1.125rem]" aria-hidden="true" />
      </a>
      {/* Goes from following the system to dark, to light and back; the
          theme script sets its label. */}
      <button
        type="button"
        data-theme-toggle
        data-auto={t.theme.auto}
        data-dark={t.theme.dark}
        data-light={t.theme.light}
        data-to-auto={t.theme.toAuto}
        data-to-dark={t.theme.toDark}
        data-to-light={t.theme.toLight}
        aria-label={`${t.theme.auto} · ${t.theme.toDark}`}
        title={`${t.theme.auto} · ${t.theme.toDark}`}
        class="theme-toggle size-9 items-center justify-center rounded-lg text-muted-foreground outline-offset-2 transition hover:bg-accent hover:text-foreground active:scale-90"
      >
        <Monitor data-theme-icon="auto" className="size-[1.125rem]" aria-hidden="true" />
        <Moon data-theme-icon="dark" className="size-[1.125rem]" aria-hidden="true" />
        <Sun data-theme-icon="light" className="size-[1.125rem]" aria-hidden="true" />
      </button>
      <AccountMenu client:load lang={lang} reader={Astro.locals.reader ?? null} checked={Astro.locals.readerChecked ?? false} signInHref={signIn} />
      <details data-menu class="group relative sm:hidden">
        <summary
          aria-label={t.nav.menu}
          class="flex size-9 cursor-pointer list-none items-center justify-center rounded-lg text-muted-foreground outline-offset-2 hover:bg-accent hover:text-foreground group-open:bg-accent group-open:text-foreground [&::-webkit-details-marker]:hidden"
        >
          <Menu className="size-5 group-open:hidden" aria-hidden="true" />
          <X className="hidden size-5 group-open:block" aria-hidden="true" />
        </summary>
        <nav aria-label={t.nav.label} class="absolute right-0 top-full z-30 mt-2 w-52 rounded-lg border bg-background p-1.5 shadow-lg">
          {
            links.map(({ icon: Icon, ...l }) => (
              <a
                href={l.href}
                aria-current={l.current ? "page" : undefined}
                class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm outline-offset-1 hover:bg-accent aria-[current=page]:bg-accent aria-[current=page]:font-medium"
              >
                <Icon className="size-4 text-muted-foreground" aria-hidden="true" />
                {l.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // "/" goes to the search field the page shows, unless the reader is
  // typing somewhere already.
  document.addEventListener("keydown", (event) => {
    if (event.key !== "/" || event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) return;
    const target = event.target;
    if (target instanceof HTMLElement && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))) return;
    const field = [...document.querySelectorAll<HTMLInputElement>("[data-search-input], [data-header-search]")].find((el) => el.getClientRects().length);
    if (!field) return;
    event.preventDefault();
    field.focus();
    field.select();
  });
</script>
