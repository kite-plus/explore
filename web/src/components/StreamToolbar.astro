---
import LangFilter from "@/components/LangFilter.astro";
import StreamFilters from "@/components/StreamFilters.astro";
import StreamTabs from "@/components/StreamTabs.astro";
import type { Lang } from "@/i18n";
import type { Tag } from "@/lib/types";

interface Props {
  lang: Lang;
  stream: "latest" | "recommended" | "following";
  path: string;
  filter?: string;
  tag?: string;
  tags: Tag[];
}

// The streams' tabs and filters in one row of fixed height, held under the
// header while the posts scroll by. The row sits one pixel over the bottom
// line, so the current tab's underline covers it.
const { lang, stream, path, filter, tag, tags } = Astro.props;
---

<div
  data-stream-toolbar
  class="sticky top-14 z-20 -mx-4 border-b bg-background/85 px-4 backdrop-blur-md sm:-mx-6 sm:px-6 lg:mx-0 lg:px-0"
>
  <div class="-mb-px flex h-12 items-stretch justify-between gap-2">
    <StreamTabs lang={lang} current={stream} query={{ lang: filter, tag }} />
    <div class="flex shrink-0 items-center gap-2">
      <div class="hidden md:block">
        <LangFilter lang={lang} path={path} current={filter} tag={tag} />
      </div>
      <StreamFilters lang={lang} path={path} tags={tags} tag={tag} filter={filter} />
    </div>
  </div>
</div>
