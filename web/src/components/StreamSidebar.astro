---
import { ArrowRight, ArrowUpRight, PenLine, Rss, Sparkles, Zap } from "lucide-react";

import BlogAvatar from "@/components/BlogAvatar.astro";
import TagGrid from "@/components/TagGrid.astro";
import { ButtonLink } from "@/components/ui/button";
import { dict, localePath, type Lang } from "@/i18n";
import type { Blog, Tag } from "@/lib/types";
import { withQuery } from "@/lib/utils";

interface Props {
  lang: Lang;
  stream: "latest" | "recommended" | "following";
  path: string;
  filter?: string;
  tag?: string;
  tags: Tag[];
  newBlogs: Blog[];
}

// What the streams show beside the posts on wide screens: a word on this
// stream, the tags, and the blogs listed last. Narrow screens keep only
// the posts.
const { lang, stream, path, filter, tag, tags, newBlogs } = Astro.props;
const t = dict(lang);
const s = t.sidebar;
const base = localePath(lang, path);
const pingHelp = lang === "zh" ? "/about#发布后更快出现" : "/en/about#appearing-sooner-after-you-publish";
---

<aside class="hidden space-y-8 pt-4 lg:sticky lg:top-14 lg:block lg:self-start">
  <section class="kite-tag relative mt-4 rounded-xl border bg-card p-5">
    <span class="kite-tag-hole" data-kite-tie aria-hidden="true"></span>
    <div class="flex items-center gap-3 pr-6">
      <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-background text-brand ring-1 ring-border [&>svg]:size-4.5">
        {stream === "latest" ? <PenLine aria-hidden="true" /> : stream === "recommended" ? <Sparkles aria-hidden="true" /> : <Rss aria-hidden="true" />}
      </span>
      <h2 class="font-serif text-[1.0625rem] font-bold">
        {stream === "latest" ? s.latestTitle : stream === "recommended" ? s.recommendedTitle : s.followingTitle}
      </h2>
    </div>
    <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
      {stream === "latest" ? s.latestBody : stream === "recommended" ? t.recommended.intro : s.followingBody}
    </p>
    {
      stream === "latest" && (
        <div class="mt-4 flex flex-col items-stretch gap-3">
          <ButtonLink href={localePath(lang, "/submit")} size="sm" className="w-full">
            {s.submit}
            <ArrowRight className="size-3.5" aria-hidden="true" />
          </ButtonLink>
          <a href={pingHelp} class="inline-flex items-center gap-1.5 text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">
            <Zap className="size-3.5 text-brand" aria-hidden="true" />
            {s.ping}
          </a>
        </div>
      )
    }
    {
      stream === "following" && (
        <a href={localePath(lang, "/account")} class="mt-4 inline-flex items-center gap-1 text-sm font-medium hover:underline underline-offset-4">
          {s.manage}
          <ArrowRight className="size-3.5" aria-hidden="true" />
        </a>
      )
    }
  </section>

  {
    tags.length > 0 && (
      <section>
        <div class="flex items-baseline justify-between">
          <h2 class="font-serif text-[0.9375rem] font-bold">{s.tags}</h2>
          {tag && (
            <a href={withQuery(base, { lang: filter })} class="text-xs text-muted-foreground hover:text-foreground" data-swap>
              {t.filter.all}
            </a>
          )}
        </div>
        <TagGrid lang={lang} path={path} tags={tags} current={tag} filter={filter} class="mt-2 grid-cols-2" />
      </section>
    )
  }

  {
    newBlogs.length > 0 && (
      <section>
        <h2 class="font-serif text-[0.9375rem] font-bold">{s.newBlogs}</h2>
        <ul class="mt-3 space-y-3">
          {newBlogs.map((blog) => (
            <li>
              <a href={localePath(lang, `/blogs/${blog.host}`)} class="group flex items-center gap-2.5">
                <BlogAvatar host={blog.host} name={blog.name} size="md" />
                <span class="min-w-0">
                  <span class="block truncate text-sm font-medium group-hover:underline" lang={blog.language}>{blog.name}</span>
                  <span class="block truncate text-xs text-muted-foreground">{blog.host}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <a href={localePath(lang, "/blogs")} class="mt-3 inline-block text-sm text-muted-foreground hover:text-foreground">
          {s.allBlogs} →
        </a>
      </section>
    )
  }

  <p class="flex gap-1.5 text-xs leading-relaxed text-muted-foreground">
    <ArrowUpRight className="mt-0.5 size-3.5 shrink-0" aria-hidden="true" />
    {s.newTab}
  </p>
</aside>
