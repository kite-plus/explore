---
import BlogAvatar from "@/components/BlogAvatar.astro";
import Highlight from "@/components/Highlight.astro";
import { dict, localePath, type Lang } from "@/i18n";
import { relativeTime } from "@/lib/format";
import type { Blog } from "@/lib/types";

interface Props {
  lang: Lang;
  blog: Blog;
  /** A search's words, marked in the name and description. */
  words?: string[];
}

// A blog in the directory's grid, and in search results.
const { lang, blog: b, words } = Astro.props;
const t = dict(lang);
---

<li
  class="group relative flex flex-col justify-between rounded-lg border bg-card p-3.5 text-card-foreground transition-colors hover:border-foreground/30 hover:bg-muted/30"
  lang={b.language}
>
  <div>
    <div class="flex items-start gap-3">
      <BlogAvatar host={b.host} name={b.name} size="lg" />
      <div class="min-w-0 flex-1">
        <a href={localePath(lang, `/blogs/${b.host}`)} class="font-medium hover:underline focus:outline-none">
          <span class="absolute inset-0" aria-hidden="true" />
          <span class="line-clamp-1"><Highlight text={b.name} words={words} /></span>
        </a>
        <p class="truncate text-xs text-muted-foreground"><Highlight text={b.host} words={words} /></p>
      </div>
    </div>
    {
      b.description && (
        <p class="mt-2.5 line-clamp-2 text-xs leading-relaxed text-muted-foreground">
          <Highlight text={b.description} words={words} />
        </p>
      )
    }
  </div>
  <div class="mt-3 flex items-center justify-between border-t pt-2 text-[0.7rem] text-muted-foreground" lang={t.htmlLang}>
    <span>{t.blogs.latest}</span>
    {b.last_published_at ? <time datetime={b.last_published_at}>{relativeTime(b.last_published_at, lang)}</time> : <span>{t.blogs.noDated}</span>}
  </div>
</li>
