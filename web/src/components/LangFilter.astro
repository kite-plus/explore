---
import { dict, localePath, type Lang } from "@/i18n";
import { withQuery } from "@/lib/utils";

interface Props {
  lang: Lang;
  path: string;
  current?: string;
  /** The tag filter in use, kept when the language changes. */
  tag?: string;
}

// Filtering by the blogs' language uses ?lang= and has nothing to do with
// the interface language, which lives in the path. It is a switch: the
// options are equal columns, so CSS alone sets the thumb under the current
// one, and the script below slides it to a new choice while the filtered
// list loads in place (lib/swap.ts). Without the script the options are
// plain links.
const { lang, path, current, tag } = Astro.props;
const t = dict(lang).filter;
const base = localePath(lang, path);
const options = [
  { value: undefined, label: t.all },
  { value: "zh", label: t.zh },
  { value: "en", label: t.en },
];
const index = Math.max(0, options.findIndex((o) => o.value === current));
---

<nav
  aria-label={t.label}
  data-switch
  data-current={index}
  class="group/switch relative grid shrink-0 grid-cols-3 rounded-lg border bg-muted/50 p-0.5 text-sm"
>
  <span
    aria-hidden="true"
    class="absolute inset-y-0.5 left-0.5 w-[calc((100%-0.25rem)/3)] rounded-md bg-background shadow-sm transition-transform duration-200 ease-out group-data-[current=1]/switch:translate-x-full group-data-[current=2]/switch:translate-x-[200%] motion-reduce:transition-none"
  ></span>
  {
    options.map((o, i) => (
      <a
        href={withQuery(base, { lang: o.value, tag })}
        data-index={i}
        aria-current={o.value === current ? "page" : undefined}
        class="relative rounded-md px-3 py-1 text-center text-muted-foreground outline-offset-2 transition-colors hover:text-foreground aria-[current=page]:font-medium aria-[current=page]:text-foreground"
      >
        {o.label}
      </a>
    ))
  }
</nav>

<script>
  import { swap } from "@/lib/swap";

  // The thumb slides to the chosen option while the list loads, and the new
  // list goes in once both are done, so the choice reads as a switch.
  document.addEventListener("click", (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("[data-switch] a[data-index]") : null;
    if (!link) return;
    event.preventDefault();
    if (link.getAttribute("aria-current") === "page") return;
    const nav = link.closest<HTMLElement>("[data-switch]")!;
    nav.querySelector("[aria-current]")?.removeAttribute("aria-current");
    link.setAttribute("aria-current", "page");
    nav.dataset.current = link.dataset.index;
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    void swap(link.href, { after: new Promise((slid) => setTimeout(slid, still ? 0 : 200)) });
  });
</script>
