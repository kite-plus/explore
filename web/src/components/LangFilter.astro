---
import { dict, localePath, type Lang } from "@/i18n";
import { withQuery } from "@/lib/utils";

interface Props {
  lang: Lang;
  path: string;
  current?: string;
  /** The tag filter in use, kept when the language changes. */
  tag?: string;
  variant?: "plain" | "segmented";
}

// Filtering by the blogs' language uses ?lang= and has nothing to do with
// the interface language, which lives in the path.
const { lang, path, current, tag, variant = "plain" } = Astro.props;
const t = dict(lang).filter;
const base = localePath(lang, path);
const options = [
  { value: undefined, label: t.all },
  { value: "zh", label: t.zh },
  { value: "en", label: t.en },
];
---

<nav
  aria-label={t.label}
  class:list={[
    "flex text-sm",
    variant === "segmented" ? "gap-0.5 rounded-lg border bg-muted/50 p-0.5" : "gap-1",
  ]}
>
  {
    options.map((o) => (
      <a
        href={withQuery(base, { lang: o.value, tag })}
        aria-current={o.value === current ? "page" : undefined}
        class:list={[
          "rounded-md px-2.5 py-1 text-muted-foreground outline-offset-2 hover:text-foreground",
          variant === "segmented"
            ? "hover:bg-background/60 aria-[current=page]:bg-background aria-[current=page]:font-medium aria-[current=page]:text-foreground aria-[current=page]:shadow-sm"
            : "hover:bg-accent hover:text-accent-foreground aria-[current=page]:bg-secondary aria-[current=page]:text-secondary-foreground",
        ]}
      >
        {o.label}
      </a>
    ))
  }
</nav>
