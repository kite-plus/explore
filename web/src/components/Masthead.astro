---
import { dict, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
}

// The head of the stream pages: what Explore is, and the kite of kite.plus
// tied to the sidebar's paper tag (global.css, .kite-*).
const { lang } = Astro.props;
const t = dict(lang);
---

<section class="kite-masthead" data-kite-masthead>
  <div class="kite-masthead-sky" aria-hidden="true">
    <svg class="kite-cloud" viewBox="-6 -16 256 120">
      <g class="cloud-under" transform="translate(10 9)">
        <rect y="44" width="236" height="46" rx="23"></rect>
        <circle cx="62" cy="50" r="34"></circle>
        <circle cx="126" cy="38" r="46"></circle>
        <circle cx="186" cy="56" r="34"></circle>
      </g>
      <g class="cloud-body">
        <rect y="44" width="236" height="46" rx="23"></rect>
        <circle cx="62" cy="50" r="34"></circle>
        <circle cx="126" cy="38" r="46"></circle>
        <circle cx="186" cy="56" r="34"></circle>
      </g>
    </svg>
  </div>
  <p class="kite-eyebrow">{t.home.mastheadEyebrow}</p>
  <h1 class="mt-3 mb-2 pr-20 font-serif text-[1.5rem] leading-snug font-black tracking-wide sm:text-[2.5rem] lg:pr-0">
    {t.home.mastheadTitle}
  </h1>
  <p class="max-w-xl pr-16 text-sm leading-relaxed text-muted-foreground sm:text-[0.9375rem] lg:pr-0">{t.home.mastheadLede}</p>
  <div class="kite-fly" aria-hidden="true">
    <svg class="kite-drawing" viewBox="0 8 64 64">
      <g transform="translate(32 32) scale(.82) translate(-32 -32)" stroke-linejoin="round" stroke-width="5">
        <path class="kite-a" d="M10 14.5 L27 21 L27 30 L10 23.5 Z"></path>
        <path class="kite-b" d="M10 32 L27 38.5 L27 49 L10 42.5 Z"></path>
        <path class="kite-c" d="M37 21 L54 14.5 L54 42.5 L37 49 Z"></path>
        <path class="kite-shine" d="M10 14.5 L27 21 L10 23.5 Z"></path>
        <path class="kite-shine dim" d="M37 21 L54 14.5 L37 49 Z"></path>
        <path class="kite-shine dim" d="M10 32 L27 38.5 L10 42.5 Z"></path>
        <path class="kite-tail" d="M10 44 C 6 50, 12 54, 7 60 S 9 68, 3 74" stroke-width=".5"></path>
        <path class="kite-bow" d="M7.6 51.4 l2.6 -1.4 l.2 2.6 z"></path>
        <path class="kite-bow gold" d="M6.6 59.6 l2.6 -1.2 l.1 2.6 z"></path>
        <path class="kite-bow" d="M5.2 67.8 l2.6 -1.2 l.1 2.6 z"></path>
      </g>
    </svg>
    <span class="kite-anchor" data-kite-anchor></span>
  </div>
  <svg class="kite-string" aria-hidden="true">
    <path data-kite-line></path>
  </svg>
</section>

<script>
  // The string runs from the kite down to the hole of the sidebar's paper
  // tag (StreamSidebar.astro) while the head is in view. Narrow screens have
  // no sidebar, and once the head scrolls away the kite has gone, so in both
  // cases the string goes too.
  const head = document.querySelector<HTMLElement>("[data-kite-masthead]");
  const line = head?.querySelector<SVGPathElement>("[data-kite-line]");
  const anchor = head?.querySelector<HTMLElement>("[data-kite-anchor]");
  if (head && line && anchor) {
    const svg = line.ownerSVGElement!;
    const update = () => {
      const tie = document.querySelector<HTMLElement>("[data-kite-tie]");
      if (!tie || !tie.getClientRects().length || !svg.getClientRects().length || head.getBoundingClientRect().bottom < 64) {
        line.setAttribute("d", "");
        return;
      }
      const o = svg.getBoundingClientRect();
      const k = anchor.getBoundingClientRect();
      const t = tie.getBoundingClientRect();
      const kx = k.left - o.left;
      const ky = k.top - o.top;
      const tx = t.left + t.width / 2 - o.left;
      const ty = t.top + t.height / 2 - o.top;
      // A line hanging under its own weight: shallow at the tie, steep at the kite.
      const c1x = tx + (kx - tx) * 0.4;
      const c1y = ty + (ky - ty) * 0.15;
      const c2x = kx + (tx - kx) * 0.12;
      const c2y = ky + (ty - ky) * 0.45;
      line.setAttribute("d", `M${tx} ${ty} C${c1x} ${c1y}, ${c2x} ${c2y}, ${kx} ${ky}`);
    };
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      update();
      addEventListener("scroll", update, { passive: true });
      addEventListener("resize", update);
      new MutationObserver(update).observe(document.body, { subtree: true, childList: true });
    } else {
      // The kite bobs, so the string follows it every frame.
      const loop = () => {
        update();
        requestAnimationFrame(loop);
      };
      loop();
    }
  }
</script>
