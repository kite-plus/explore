---
import { dict, localePath, type Lang } from "@/i18n";
import type { Tag } from "@/lib/types";
import { withQuery } from "@/lib/utils";

interface Props {
  lang: Lang;
  path: string;
  tags: Tag[];
  current?: string;
  /** The blog-language filter in use, kept when the tag changes. */
  filter?: string;
}

const { lang, path, tags, current, filter } = Astro.props;
const t = dict(lang).filter;
const base = localePath(lang, path);
const options = [{ value: undefined, label: t.all }, ...tags.map((tag) => ({ value: tag.slug, label: tag.name[lang] }))];
const selected = options.find((option) => option.value === current)?.label ?? t.all;
---

{
  tags.length > 0 && (
    <details class="group relative text-sm">
      <summary class="flex min-h-8 cursor-pointer list-none items-center gap-2 rounded-lg border px-2.5 py-1 text-muted-foreground outline-offset-2 hover:bg-accent hover:text-accent-foreground [&::-webkit-details-marker]:hidden">
        <span>{t.tags}</span>
        <span class="max-w-24 truncate font-medium text-foreground">{selected}</span>
        <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" class="size-3.5 text-muted-foreground group-open:rotate-180">
          <path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <nav aria-label={t.tags} class="absolute right-0 top-full z-20 mt-2 grid max-h-80 w-72 max-w-[calc(100vw-2rem)] grid-cols-2 gap-1 overflow-y-auto rounded-lg border bg-background p-2 shadow-lg">
        {options.map((o) => (
          <a
            href={withQuery(base, { lang: filter, tag: o.value })}
            aria-current={o.value === current ? "page" : undefined}
            class="rounded-md px-2.5 py-1.5 text-muted-foreground outline-offset-1 hover:bg-accent hover:text-accent-foreground aria-[current=page]:bg-secondary aria-[current=page]:font-medium aria-[current=page]:text-secondary-foreground"
          >
            {o.label}
          </a>
        ))}
      </nav>
    </details>
  )
}
