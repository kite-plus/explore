---
import BlogAvatar from "@/components/BlogAvatar.astro";
import { CircleCheck, CircleHelp, CircleX } from "lucide-react";
import ExternalLink from "@/components/ExternalLink.astro";
import { TagIcon } from "@/components/TagIcon";
import { dict, localePath, type Lang } from "@/i18n";
import { withSource } from "@/lib/config";
import { relativeTime } from "@/lib/format";
import type { Entry } from "@/lib/types";
import { withQuery } from "@/lib/utils";

interface Props {
  lang: Lang;
  entry: Entry;
  /** The blog's language, when the entry does not carry its blog. */
  blogLanguage?: string;
  /** The blog's host and name, when the entry does not carry its blog. */
  blogHost?: string;
  blogName?: string;
  /** Tag names by slug; tags without a name are not shown. */
  tagNames?: Record<string, string>;
  tagPath?: string;
}

const { lang, entry, blogLanguage, blogHost, blogName, tagNames = {}, tagPath = "/" } = Astro.props;
const tags = (entry.tags ?? []).filter((slug) => tagNames[slug]);
const t = dict(lang);
// Titles and excerpts stay as the author wrote them; lang tells screen
// readers and search engines which language that is.
const contentLang = entry.blog?.language ?? blogLanguage;
const linkStatus = entry.link_status ?? "unknown";
const statusLabel = linkStatus === "available"
  ? t.entryStatus.available
  : linkStatus === "unavailable"
    ? t.entryStatus.unavailable
    : entry.link_checked_at
      ? t.entryStatus.unknown
      : t.entryStatus.pending;
const checkedAt = entry.link_checked_at ? t.entryStatus.checkedAt(relativeTime(entry.link_checked_at, lang)) : null;
const statusDescription = [statusLabel, checkedAt, t.entryStatus.hint].filter(Boolean).join(" · ");
const pending = linkStatus === "unknown" && !entry.link_checked_at;
const statusClass = linkStatus === "available" || linkStatus === "unavailable" ? `entry-status-${linkStatus}` : "entry-status-unknown";
---

<article class="flex gap-4 border-b py-4" lang={contentLang}>
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground" lang={t.htmlLang}>
    {
      entry.blog && (
        <a href={localePath(lang, `/blogs/${entry.blog.host}`)} class="inline-flex min-w-0 items-center gap-1.5 font-medium text-foreground/80 hover:text-foreground">
          <BlogAvatar host={entry.blog.host} name={entry.blog.name} />
          <span class="truncate" lang={contentLang}>{entry.blog.name}</span>
        </a>
      )
    }
    {entry.blog && <span aria-hidden="true">·</span>}
    {
      entry.published_at ? (
        <time datetime={entry.published_at}>{relativeTime(entry.published_at, lang)}</time>
      ) : (
        <span>{t.blog.undated}</span>
      )
    }
    <span aria-hidden="true">·</span>
    {pending ? (
      <>
        <span class="entry-check-fallback entry-status-unknown items-center gap-1" title={statusDescription}>
          <CircleHelp className="size-3" aria-hidden="true" />{statusLabel}
        </span>
        <button
          type="button"
          class="entry-check-button entry-status-unknown items-center gap-1 rounded-sm hover:text-foreground hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
          data-entry-check={entry.id}
          data-lang={lang}
          data-checking={t.entryStatus.checking}
          data-retry={t.entryStatus.retry}
          data-failed={t.entryStatus.failed}
          data-available={t.entryStatus.available}
          data-unavailable={t.entryStatus.unavailable}
          data-unknown={t.entryStatus.unknown}
          data-just-checked={t.entryStatus.justChecked}
          data-hint={t.entryStatus.hint}
          aria-label={t.entryStatus.checkNow}
          title={t.entryStatus.checkNow}
        >
          <CircleHelp className="size-3" aria-hidden="true" />
          <span data-check-label>{statusLabel}</span>
        </button>
        <span data-entry-check-result class="hidden items-center gap-1 rounded-full" role="status">
          <CircleCheck data-link-icon="available" className="hidden size-3.5" aria-hidden="true" />
          <CircleX data-link-icon="unavailable" className="hidden size-3" aria-hidden="true" />
          <CircleHelp data-link-icon="unknown" className="hidden size-3" aria-hidden="true" />
          <span data-link-label></span>
        </span>
        <time data-entry-check-time class="hidden"></time>
      </>
    ) : (
      <>
        <span
          class:list={[
            "inline-flex items-center gap-1 rounded-full",
            statusClass,
            linkStatus === "unavailable" && "px-2 py-0.5",
          ]}
          title={statusDescription}
        >
          {linkStatus === "available" ? (
            <CircleCheck className="size-3.5" aria-hidden="true" />
          ) : linkStatus === "unavailable" ? (
            <CircleX className="size-3" aria-hidden="true" />
          ) : (
            <CircleHelp className="size-3" aria-hidden="true" />
          )}
          {linkStatus === "available" ? <span class="sr-only">{statusDescription}</span> : statusLabel}
        </span>
        {entry.link_checked_at && linkStatus !== "available" && <time datetime={entry.link_checked_at}>{checkedAt}</time>}
      </>
    )}
    </div>
    <h3 class="mt-1.5 text-[0.9375rem] leading-snug font-semibold sm:text-base">
      <ExternalLink
        lang={lang}
        href={withSource(entry.url)}
        class="hover:underline"
        data-go={localePath(lang, "/go")}
        data-go-site={entry.blog?.host ?? blogHost}
        data-go-blog={entry.blog?.name ?? blogName}
        data-go-title={entry.title}
      >{entry.title}</ExternalLink>
    </h3>
    {entry.excerpt && <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-muted-foreground">{entry.excerpt}</p>}
    {
      tags.length > 0 && (
        <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs" lang={t.htmlLang}>
          {tags.map((slug) => (
            <a
              href={withQuery(localePath(lang, tagPath), { tag: slug })}
              class="inline-flex items-center gap-1 text-muted-foreground transition-colors hover:text-brand"
              data-swap
            >
              <TagIcon slug={slug} className="size-3.5" />{tagNames[slug]}
            </a>
          ))}
        </div>
      )
    }
  </div>
  {
    entry.image_url && (
      <div class="mt-1 h-16 w-24 shrink-0 overflow-hidden rounded-lg border bg-muted sm:h-20 sm:w-30">
        <img src={entry.image_url} alt="" loading="lazy" decoding="async" data-entry-cover class="h-full w-full object-cover" />
      </div>
    )
  }
</article>

<script>
  // A plain click on a post's title opens it through the transition page
  // (views/Go.astro), which says where the reader is going before going.
  // The link stays the post's address, for crawlers, copied links and
  // clicks that ask for something else.
  document.addEventListener("click", (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("a[data-go]") : null;
    if (!link) return;
    const hash = new URLSearchParams({
      to: link.href,
      site: link.dataset.goSite ?? "",
      blog: link.dataset.goBlog ?? "",
      title: link.dataset.goTitle ?? "",
    });
    // Opened with an opener, which tells the page Explore sent the reader.
    // When the browser blocks it, the plain link still opens the post.
    if (window.open(`${link.dataset.go}#${hash}`, "_blank")) event.preventDefault();
  });
</script>
