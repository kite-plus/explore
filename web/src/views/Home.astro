---
import EntryStream from "@/components/EntryStream.astro";
import Message from "@/components/Message.astro";
import StreamSidebar from "@/components/StreamSidebar.astro";
import StreamToolbar from "@/components/StreamToolbar.astro";
import SwapRoot from "@/components/SwapRoot.astro";
import { ButtonLink } from "@/components/ui/button";
import { dict, localePath, type Lang } from "@/i18n";
import Base from "@/layouts/Base.astro";
import type { Loaded, StreamPage } from "@/lib/loaders";
import { tagNames } from "@/lib/tags";
import { withQuery } from "@/lib/utils";

interface Props {
  lang: Lang;
  result: Loaded<StreamPage>;
  // The latest stream, or the recommended one: same posts, other rules.
  stream?: "latest" | "recommended";
}

const { lang, result, stream = "latest" } = Astro.props;
const t = dict(lang);
const data = result.kind === "ok" ? result.data : undefined;
const recommended = stream === "recommended";
const path = recommended ? "/recommended" : "/";

const older =
  data?.page.next_cursor &&
  withQuery(localePath(lang, path), { cursor: data.page.next_cursor, lang: data.filter, tag: data.tag });
const names = data ? tagNames(data.tags, lang) : {};
// Without filters, an empty recommended stream means nothing is rated yet.
const unrated = recommended && !data?.paged && !data?.filter && !data?.tag;
---

<Base
  lang={lang}
  title={recommended ? t.recommended.title : t.home.title}
  description={recommended ? t.recommended.intro : t.site.description}
  path={path}
  entryChecks
  wide
  noindex={Boolean(data?.paged || data?.filter || data?.tag)}
>
  {
    data ? (
      <SwapRoot class="lg:grid lg:grid-cols-[minmax(0,1fr)_17.5rem] lg:items-start lg:gap-12">
        <div class="min-w-0">
          <h1 class="sr-only">{t.home.heading}</h1>
          <StreamToolbar lang={lang} stream={stream} path={path} filter={data.filter} tag={data.tag} tags={data.tags} />
          {data.page.data.length === 0 && unrated ? (
            <div class="flex flex-col items-center gap-4 py-16 text-center">
              <p class="max-w-prose text-muted-foreground">{t.recommended.empty}</p>
              <ButtonLink href={localePath(lang, "/")} variant="outline">{t.recommended.latest}</ButtonLink>
            </div>
          ) : data.page.data.length === 0 ? (
            <p class="py-16 text-center text-muted-foreground">{t.home.empty}</p>
          ) : (
            <EntryStream lang={lang} entries={data.page.data} tagNames={names} tagPath={path} older={older} />
          )}
        </div>
        <StreamSidebar lang={lang} stream={stream} path={path} filter={data.filter} tag={data.tag} tags={data.tags} newBlogs={data.newBlogs} />
      </SwapRoot>
    ) : (
      <Message lang={lang} kind={result.kind === "unavailable" ? "unavailable" : "notFound"} />
    )
  }
</Base>
