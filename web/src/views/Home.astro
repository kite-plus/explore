---
import EntryItem from "@/components/EntryItem.astro";
import LangFilter from "@/components/LangFilter.astro";
import Message from "@/components/Message.astro";
import TagFilter from "@/components/TagFilter.astro";
import { ButtonLink } from "@/components/ui/button";
import { dict, localePath, type Lang } from "@/i18n";
import Base from "@/layouts/Base.astro";
import type { Loaded, StreamPage } from "@/lib/loaders";
import { tagNames } from "@/lib/tags";
import { withQuery } from "@/lib/utils";

interface Props {
  lang: Lang;
  result: Loaded<StreamPage>;
}

const { lang, result } = Astro.props;
const t = dict(lang);
const data = result.kind === "ok" ? result.data : undefined;

const older =
  data?.page.next_cursor &&
  withQuery(localePath(lang, "/"), { cursor: data.page.next_cursor, lang: data.filter, tag: data.tag });
const names = data ? tagNames(data.tags, lang) : {};
---

<Base
  lang={lang}
  title={t.home.title}
  description={t.site.description}
  path="/"
  entryChecks
  noindex={Boolean(data?.paged || data?.filter || data?.tag)}
>
  {
    data ? (
      <>
        <div>
          <h1 class="text-[1.75rem] font-semibold tracking-tight">{t.home.heading}</h1>
          <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-muted-foreground">{t.home.intro}</p>
        </div>
        <div class="mt-5 flex flex-wrap items-end justify-between gap-x-5 gap-y-3 border-b">
          <nav aria-label={t.home.feedLabel} class="flex items-end gap-6">
            <a
              href={withQuery(localePath(lang, "/"), { lang: data.filter, tag: data.tag })}
              aria-current="page"
              class="-mb-px border-b-2 border-foreground pb-3 text-sm font-semibold text-foreground outline-offset-4"
            >
              {t.home.discover}
            </a>
            <a href={localePath(lang, "/following")} class="pb-3 text-sm text-muted-foreground hover:text-foreground">
              {t.home.subscriptions}
            </a>
          </nav>
          <div class="flex flex-wrap items-center gap-2 pb-2">
            <LangFilter lang={lang} path="/" current={data.filter} tag={data.tag} variant="segmented" />
            <TagFilter lang={lang} path="/" tags={data.tags} current={data.tag} filter={data.filter} />
          </div>
        </div>
        {data.page.data.length === 0 ? (
          <p class="py-16 text-center text-muted-foreground">{t.home.empty}</p>
        ) : (
          <div class="divide-y" data-entry-stream>
            {data.page.data.map((entry) => (
              <EntryItem lang={lang} entry={entry} tagNames={names} />
            ))}
          </div>
        )}
        {older && (
          <div class="mt-6 flex flex-col items-start gap-3" data-entry-pagination>
            <ButtonLink
              href={older}
              variant="outline"
              data-load-more-btn
              data-label-older={t.home.older}
              data-label-loading={t.home.loading}
              data-label-retry={t.home.retry}
            >
              <span data-load-more-text>{t.home.older}</span>
            </ButtonLink>
            <p data-load-more-end class="hidden text-sm text-muted-foreground">{t.home.end}</p>
          </div>
        )}
      </>
    ) : (
      <Message lang={lang} kind={result.kind === "unavailable" ? "unavailable" : "notFound"} />
    )
  }
</Base>
