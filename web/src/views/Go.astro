---
import "@/styles/global.css";

import Logo from "@/components/Logo.astro";
import { dict, localePath, type Lang } from "@/i18n";
import themeScript from "@/scripts/theme.js?raw";

interface Props {
  lang: Lang;
}

// The page a post opens through: it names where the reader is going, then
// goes there. All it knows of the destination it reads in the browser
// (scripts/go.js); the server sends every reader the same page. It is drawn
// as a paper tag with the kite of kite.plus tied to it (global.css, .go-*).
const { lang } = Astro.props;
const t = dict(lang);
const g = t.go;
const button = "inline-flex h-10 items-center justify-center rounded-lg px-5 text-sm font-semibold";
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeScript} />
    <title>{g.title} - Explore</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="flex min-h-dvh flex-col items-center justify-center px-5 pt-36 pb-10 text-foreground">
    <main class="go-tag" data-go-page>
      <h1 class="sr-only">{g.title}</h1>
      <svg class="go-kite" viewBox="0 0 120 150" aria-hidden="true">
        <path class="go-kite-string" d="M100 135 C 92 104, 60 84, 45 30"></path>
        <svg x="0" y="0" width="74" height="74" viewBox="0 8 64 64">
          <g transform="rotate(-14 32 40) translate(32 32) scale(.82) translate(-32 -32)" stroke-linejoin="round" stroke-width="5">
            <path class="kite-a" d="M10 14.5 L27 21 L27 30 L10 23.5 Z"></path>
            <path class="kite-b" d="M10 32 L27 38.5 L27 49 L10 42.5 Z"></path>
            <path class="kite-c" d="M37 21 L54 14.5 L54 42.5 L37 49 Z"></path>
            <path class="kite-shine" d="M10 14.5 L27 21 L10 23.5 Z"></path>
            <path class="kite-shine dim" d="M37 21 L54 14.5 L37 49 Z"></path>
            <path class="kite-shine dim" d="M10 32 L27 38.5 L10 42.5 Z"></path>
            <path class="kite-tail" d="M10 44 C 6 50, 12 54, 7 60 S 9 68, 3 74" stroke-width=".5"></path>
            <path class="kite-bow" d="M7.6 51.4 l2.6 -1.4 l.2 2.6 z"></path>
            <path class="kite-bow gold" d="M6.6 59.6 l2.6 -1.2 l.1 2.6 z"></path>
            <path class="kite-bow" d="M5.2 67.8 l2.6 -1.2 l.1 2.6 z"></path>
          </g>
        </svg>
        <circle class="go-kite-hole" cx="100" cy="135" r="6"></circle>
      </svg>

      <section data-go-going hidden>
        <p class="kite-eyebrow">{g.going}</p>
        <div class="mt-6 flex items-center gap-3.5">
          <span
            data-go-avatar
            class="group/avatar relative inline-flex size-11 shrink-0 -rotate-3 items-center justify-center overflow-hidden rounded-[9px] font-serif text-lg font-bold text-white shadow-[inset_0_0_0_2px_rgb(255_255_255/0.22)]"
          >
            <span data-go-initial class="group-[.has-favicon]/avatar:hidden"></span>
            <img data-blog-favicon data-go-favicon alt="" class="absolute inset-0 hidden size-full object-contain p-1 group-[.has-favicon]/avatar:block group-[.has-favicon]/avatar:bg-white" />
          </span>
          <div class="min-w-0">
            <p data-go-blog class="truncate font-semibold"></p>
            <p data-go-host class="truncate font-mono text-xs text-muted-foreground"></p>
          </div>
        </div>
        <p data-go-title class="mt-5 line-clamp-3 font-serif text-xl leading-normal font-bold tracking-wide"></p>
        <svg class="go-line" viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true">
          <path pathLength="1" d="M2 6 C 80 11, 220 1, 298 6"></path>
        </svg>
        <a data-go-direct class="mt-4 inline-block text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">{g.direct}</a>
      </section>

      <section data-go-confirm hidden>
        <p class="kite-eyebrow">Explore</p>
        <h2 class="mt-4 font-serif text-2xl font-bold">{g.confirmTitle}</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{g.confirmBody}</p>
        <p data-go-url class="mt-4 rounded-lg border border-dashed border-dash bg-background/60 px-3 py-2.5 font-mono text-xs break-all"></p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a data-go-continue class={`${button} bg-primary text-primary-foreground hover:bg-primary/90`}>{g.continue}</a>
          <a href={localePath(lang, "/")} class={`${button} border border-input bg-card hover:bg-accent`}>{g.back}</a>
        </div>
      </section>

      <section data-go-missing hidden>
        <p class="kite-eyebrow">Explore</p>
        <p class="mt-4 font-serif text-xl font-bold">{g.missing}</p>
        <a href={localePath(lang, "/")} class={`${button} mt-6 border border-input bg-card hover:bg-accent`}>{g.back}</a>
      </section>
    </main>
    <a href={localePath(lang, "/")} class="mt-8 inline-flex items-center gap-2 text-muted-foreground hover:text-foreground">
      <Logo class="h-4 w-auto" />
      <span class="font-serif text-sm font-bold">Explore</span>
    </a>

    <script>
      import { avatarColor, initial } from "@/lib/avatar";
      import { destination, openedByExplore } from "@/scripts/go.js";

      const page = document.querySelector<HTMLElement>("[data-go-page]")!;
      const part = <T extends HTMLElement>(name: string) => page.querySelector<T>(`[data-go-${name}]`)!;
      const to = destination(location.hash);
      // Whatever the post's site is, it must not reach back into Explore.
      const trusted = openedByExplore(window);
      window.opener = null;

      if (!to) {
        part("missing").hidden = false;
      } else if (trusted) {
        const site = to.site || to.host;
        part("blog").textContent = to.blog || to.host;
        part("host").textContent = to.host;
        part("title").textContent = to.title;
        part("initial").textContent = initial(to.blog || to.host);
        part("avatar").classList.add(avatarColor(site));
        part<HTMLImageElement>("favicon").src = `/api/v1/blogs/${encodeURIComponent(site)}/favicon`;
        part<HTMLAnchorElement>("direct").href = to.url;
        part("going").hidden = false;
        setTimeout(() => location.replace(to.url), 700);
      } else {
        part("url").textContent = to.url;
        part<HTMLAnchorElement>("continue").href = to.url;
        part("confirm").hidden = false;
      }
    </script>
  </body>
</html>
