---
import { Pin } from "lucide-react";
import ExternalLink from "@/components/ExternalLink.astro";
import Message from "@/components/Message.astro";
import { buttonVariants } from "@/components/ui/button";
import { dict, type Lang } from "@/i18n";
import Base from "@/layouts/Base.astro";
import { withSource } from "@/lib/config";
import { formatDate } from "@/lib/format";
import type { Loaded } from "@/lib/loaders";
import type { Notice } from "@/lib/types";
import { cn } from "@/lib/utils";

interface Props {
  lang: Lang;
  id: string;
  result: Loaded<Notice>;
}

// A notice or ad's own page: its title, who it is from, its mark and its
// text, which is plain and splits into paragraphs at blank lines
// (docs/design/notices.md). It stays out of search.
const { lang, id, result } = Astro.props;
const t = dict(lang);
const notice = result.kind === "ok" ? result.data : undefined;
const ad = notice?.kind === "ad";
const paragraphs = (notice?.body ?? "").split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const link = notice?.url ? (ad ? withSource(notice.url) : notice.url) : "";
---

<Base lang={lang} title={notice ? notice.title : t.errors.notFound} description={notice?.summary || notice?.title || t.errors.notFound} path={`/notices/${id}`} noindex>
  {
    notice ? (
      <article class="mx-auto max-w-xl">
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted-foreground">
          <span class="font-medium text-foreground/80">{notice.source_name}</span>
          <span aria-hidden="true">·</span>
          <span
            class={cn(
              "inline-flex items-center gap-0.5 rounded-full px-1.5 py-px text-xs font-medium",
              ad ? "border border-border text-muted-foreground" : "bg-warning/12 text-warning",
            )}
          >
            {notice.position === 0 && <Pin className="size-3" aria-hidden="true" />}
            {notice.position === 0 && <span class="sr-only">{t.notices.pinned}</span>}
            {ad ? t.notices.ad : t.notices.notice}
          </span>
          <span aria-hidden="true">·</span>
          <time datetime={notice.published_at}>{formatDate(notice.published_at, lang)}</time>
        </div>
        <h1 class="mt-3 text-2xl leading-snug font-semibold tracking-tight">{notice.title}</h1>
        {notice.summary && <p class="mt-3 leading-relaxed text-muted-foreground">{notice.summary}</p>}
        {paragraphs.length > 0 && (
          <div class="mt-6 space-y-4 leading-relaxed">
            {paragraphs.map((p) => (
              <p class="whitespace-pre-line">{p}</p>
            ))}
          </div>
        )}
        {link && (
          <div class="mt-8">
            <ExternalLink lang={lang} href={link} class={cn(buttonVariants({ size: "lg" }), "w-full sm:w-auto")}>
              {t.notices.open}
            </ExternalLink>
          </div>
        )}
        {ad && <p class="mt-6 text-xs text-muted-foreground">{t.notices.adNote}</p>}
      </article>
    ) : (
      <Message lang={lang} kind={result.kind === "unavailable" ? "unavailable" : "notFound"} />
    )
  }
</Base>
