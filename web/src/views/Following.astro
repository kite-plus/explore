---
import EntryStream from "@/components/EntryStream.astro";
import Message from "@/components/Message.astro";
import StreamSidebar from "@/components/StreamSidebar.astro";
import StreamToolbar from "@/components/StreamToolbar.astro";
import { dict, localePath, type Lang } from "@/i18n";
import Base from "@/layouts/Base.astro";
import type { Loaded, StreamPage } from "@/lib/loaders";
import { tagNames } from "@/lib/tags";
import { withQuery } from "@/lib/utils";

interface Props {
  lang: Lang;
  result: Loaded<StreamPage>;
}

const { lang, result } = Astro.props;
const t = dict(lang);
const data = result.kind === "ok" ? result.data : undefined;
const names = data ? tagNames(data.tags, lang) : {};
const older =
  data?.page.next_cursor &&
  withQuery(localePath(lang, "/following"), { cursor: data.page.next_cursor, lang: data.filter, tag: data.tag });
---

<Base lang={lang} title={t.home.subscriptions} description={t.home.subscriptions} path="/following" noindex entryChecks wide>
  {
    data ? (
      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:items-start lg:gap-12">
        <div class="min-w-0">
          <h1 class="sr-only">{t.home.heading}</h1>
          <StreamToolbar lang={lang} stream="following" path="/following" filter={data.filter} tag={data.tag} tags={data.tags} />
          {data.page.data.length > 0 ? (
            <EntryStream lang={lang} entries={data.page.data} tagNames={names} tagPath="/following" older={older} />
          ) : (
            <p class="py-16 text-center text-muted-foreground">{t.home.followingEmpty}</p>
          )}
        </div>
        <StreamSidebar lang={lang} stream="following" path="/following" filter={data.filter} tag={data.tag} tags={data.tags} newBlogs={data.newBlogs} />
      </div>
    ) : (
      <Message lang={lang} kind={result.kind === "unavailable" ? "unavailable" : "notFound"} />
    )
  }
</Base>
