---
import BlogAvatar from "@/components/BlogAvatar.astro";
import { SubscribeButton } from "@/components/reader/SubscribeButton";
import { ReportButton } from "@/components/reader/ReportButton";
import EntryItem from "@/components/EntryItem.astro";
import ExternalLink from "@/components/ExternalLink.astro";
import Message from "@/components/Message.astro";
import { Badge } from "@/components/ui/badge";
import { ButtonLink, buttonVariants } from "@/components/ui/button";
import { dict, localePath, type Lang } from "@/i18n";
import Base from "@/layouts/Base.astro";
import type { BlogView, Loaded } from "@/lib/loaders";
import { tagNames } from "@/lib/tags";
import { withQuery } from "@/lib/utils";

interface Props {
  lang: Lang;
  host: string;
  result: Loaded<BlogView>;
}

const { lang, host, result } = Astro.props;
const t = dict(lang);
const data = result.kind === "ok" ? result.data : undefined;
const names = data ? tagNames(data.tags, lang) : {};
const older = data?.next_cursor && withQuery(localePath(lang, `/blogs/${host}`), { cursor: data.next_cursor });
const title = data ? data.blog.name : t.errors.notFound;
const description = data
  ? t.blog.description(
      data.blog.name,
      data.entries.slice(0, 3).map((e) => e.title),
    )
  : t.errors.blogNotFound;
---

<Base lang={lang} title={title} description={description} path={`/blogs/${host}`} entryChecks noindex={Boolean(data?.paged)}>
  {
    data ? (
      <>
        <header class="flex items-center gap-4" lang={data.blog.language}>
          <BlogAvatar host={data.blog.host} name={data.blog.name} size="lg" />
          <div class="min-w-0">
            <h1 class="text-2xl font-semibold tracking-tight">{data.blog.name}</h1>
            <p class="truncate text-sm text-muted-foreground">{data.blog.host}</p>
          </div>
        </header>
        {data.blog.description && <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground" lang={data.blog.language}>{data.blog.description}</p>}
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <ExternalLink lang={lang} href={data.blog.site_url} class={buttonVariants({ size: "sm" })}>
            {t.blog.visit}
          </ExternalLink>
          <ExternalLink lang={lang} href={data.blog.feed_url} class={buttonVariants({ size: "sm", variant: "outline" })}>
            {t.blog.feed}
          </ExternalLink>
          <SubscribeButton client:load host={data.blog.host} lang={lang} />
          <ReportButton client:load host={data.blog.host} lang={lang} />
          {data.blog.generator && data.blog.generator !== "unknown" && data.blog.generator !== "other" && (
            <Badge variant="outline" title={t.blog.system}>
              {data.blog.generator}
            </Badge>
          )}
        </div>
        <h2 class="mt-10 text-sm font-medium text-muted-foreground">{t.blog.recent}</h2>
        {data.entries.length === 0 ? (
          <p class="py-10 text-muted-foreground">{t.blog.empty}</p>
        ) : (
          <div class="divide-y" data-entry-stream>
            {data.entries.map((entry) => (
              <EntryItem lang={lang} entry={entry} blogLanguage={data.blog.language} tagNames={names} />
            ))}
          </div>
        )}
        {older && (
          <div class="mt-6 flex flex-col items-start gap-3" data-entry-pagination>
            <ButtonLink
              href={older}
              variant="outline"
              data-load-more-btn
              data-label-older={t.home.older}
              data-label-loading={t.home.loading}
              data-label-retry={t.home.retry}
            >
              <span data-load-more-text>{t.home.older}</span>
            </ButtonLink>
            <p data-load-more-end class="hidden text-sm text-muted-foreground">{t.home.end}</p>
          </div>
        )}
      </>
    ) : (
      <Message lang={lang} kind={result.kind === "unavailable" ? "unavailable" : "blogNotFound"} />
    )
  }
</Base>
