---
import Message from "@/components/Message.astro";
import Problems from "@/components/Problems.astro";
import { Button, ButtonLink } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { dict, localePath, type Lang } from "@/i18n";
import Base from "@/layouts/Base.astro";
import type { SubmitState } from "@/lib/loaders";
import submitProbeScript from "@/scripts/submit-probe.js?raw";

interface Props {
  lang: Lang;
  state: SubmitState;
}

const { lang, state } = Astro.props;
const t = dict(lang);
const outcome = state.outcome;
---

<Base lang={lang} title={t.submit.title} description={t.submit.intro} path="/submit" noindex>
  {
    outcome?.kind === "unavailable" ? (
      <Message lang={lang} kind="unavailable" />
    ) : (
      <>
        <h1 class="text-2xl font-semibold tracking-tight">{t.submit.title}</h1>
        <p class="mt-2 max-w-prose text-sm text-muted-foreground">{t.submit.intro}</p>

        {outcome?.kind === "listed" && (
          <div class="mt-6 rounded-lg border p-4 text-sm">
            <p>{t.submit.listed}</p>
            {outcome.host && (
              <ButtonLink href={localePath(lang, `/blogs/${outcome.host}`)} variant="link" className="mt-1 h-auto px-0">
                {t.submit.viewBlog}
              </ButtonLink>
            )}
          </div>
        )}
        {outcome?.kind === "message" && (
          <p role="alert" class="mt-6 rounded-lg border border-destructive/30 p-4 text-sm text-destructive">
            {outcome.text}
          </p>
        )}
        {outcome?.kind === "failed" && (
          <section class="mt-6" role="alert">
            <p class="mb-3 text-sm font-medium text-destructive">{t.submit.failed}</p>
            <Problems lang={lang} problems={outcome.report.problems} />
          </section>
        )}

        <form method="post" data-submit-form class="mt-8 flex max-w-xl flex-col gap-5">
          <div
            data-probe-error
            class="hidden"
            data-text-listed={t.submit.listed}
            data-text-view-blog={t.submit.viewBlog}
            data-text-pending={t.submission.status.pending}
            data-text-view-status={t.submission.title}
            data-text-failed={t.submit.failed}
            data-text-error={t.submit.invalid}
            data-text-unavailable={t.errors.unavailableBody}
          />

          <label class="flex flex-col gap-2 text-sm font-medium">
            {t.submit.site}
            <Input
              type="url"
              name="site_url"
              required
              placeholder="https://blog.example.com/"
              defaultValue={state.values.site_url}
            />
          </label>

          <div data-preview-section class="hidden rounded-lg border bg-card p-5 text-card-foreground shadow-sm flex flex-col gap-4">
            <div class="flex items-center justify-between border-b pb-3">
              <div class="flex items-center gap-3">
                <span data-preview-avatar class="size-10 rounded-full flex items-center justify-center font-bold text-white text-lg shrink-0 bg-primary">
                  <span data-preview-initial>?</span>
                </span>
                <div>
                  <h2 class="text-base font-semibold leading-tight">{t.submit.previewTitle}</h2>
                  <p data-preview-host class="text-xs text-muted-foreground mt-0.5"></p>
                </div>
              </div>
              <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <span>{t.submit.articlesCount}:</span>
                <span data-preview-articles class="font-medium text-foreground"></span>
              </div>
            </div>

            <p class="text-xs text-muted-foreground leading-relaxed">{t.submit.previewDesc}</p>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <label class="flex flex-col gap-1.5 text-xs font-medium">
                {t.submit.name}
                <Input type="text" name="title" maxLength={100} defaultValue={state.values.title} />
              </label>
              <label class="flex flex-col gap-1.5 text-xs font-medium">
                {t.submit.discoveredFeed}
                <p data-preview-feed class="truncate rounded-md border bg-muted/40 px-3 py-2 text-xs font-mono text-muted-foreground"></p>
              </label>
            </div>

            <label class="flex flex-col gap-1.5 text-xs font-medium">
              {t.submit.desc}
              <Textarea name="description" maxLength={240} rows={2} defaultValue={state.values.description} />
            </label>

            <div class="hidden items-center gap-2 rounded bg-muted/50 px-3 py-2 text-xs text-muted-foreground">
              <span class="font-medium text-foreground shrink-0">{t.submit.latestPost}:</span>
              <span data-preview-latest class="truncate font-normal"></span>
            </div>
          </div>

          <label class="flex flex-col gap-2 text-sm font-medium">
            {t.submit.feed}
            <Input type="url" name="feed_url" placeholder="https://blog.example.com/atom.xml" defaultValue={state.values.feed_url} />
            <span class="text-xs font-normal text-muted-foreground">{t.submit.feedHint}</span>
          </label>
          <label class="flex flex-col gap-2 text-sm font-medium">
            {t.submit.note}
            <Textarea name="note" maxLength={500} rows={3} defaultValue={state.values.note} />
            <span class="text-xs font-normal text-muted-foreground">{t.submit.noteHint}</span>
          </label>

          <div class="flex flex-wrap items-center gap-3">
            <Button
              type="submit"
              data-main-btn
              data-label-probe={t.submit.probe}
              data-label-probing={t.submit.probing}
              data-label-confirm={t.submit.confirmButton}
              data-label-fallback={t.submit.button}
            >
              {t.submit.probe}
            </Button>
            <span data-wait-hint class="text-xs text-muted-foreground">{t.submit.wait}</span>
          </div>
        </form>
        <script set:html={submitProbeScript} />
      </>
    )
  }
</Base>
