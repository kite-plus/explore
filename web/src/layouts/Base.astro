---
import "@/styles/global.css";

import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { dict, localePath, other, type Lang } from "@/i18n";
import { publicURL } from "@/lib/config";
import entryCheckScript from "@/scripts/entry-check.js?raw";
import entryStreamScript from "@/scripts/entry-stream.js?raw";
import themeScript from "@/scripts/theme.js?raw";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** The page's path without the /en prefix and without a query string. */
  path: string;
  /** Pages that only change with query parameters stay out of the index. */
  noindex?: boolean;
  /** False for pages that exist only once, such as /bot. */
  bilingual?: boolean;
  entryChecks?: boolean;
  wide?: boolean;
}

const { lang, title, description, path, noindex = false, bilingual = true, entryChecks = false, wide = false } = Astro.props;
const t = dict(lang);
const base = publicURL();
const canonical = base + localePath(lang, path);
const fullTitle = title === t.site.name ? title : `${title} - ${t.site.name}`;
const verification = {
  baidu: process.env.EXPLORE_SITE_VERIFICATION_BAIDU,
  google: process.env.EXPLORE_SITE_VERIFICATION_GOOGLE,
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeScript} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      bilingual && (
        <>
          <link rel="alternate" hreflang="zh" href={base + localePath("zh", path)} />
          <link rel="alternate" hreflang="en" href={base + localePath("en", path)} />
          <link rel="alternate" hreflang="x-default" href={base + localePath("en", path)} />
        </>
      )
    }
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Explore" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    {bilingual && <meta property="og:locale:alternate" content={dict(other(lang)).ogLocale} />}
    <link rel="alternate" type="application/rss+xml" title="Explore" href="/feed.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {verification.baidu && <meta name="baidu-site-verification" content={verification.baidu} />}
    {verification.google && <meta name="google-site-verification" content={verification.google} />}
  </head>
  <body class="flex min-h-dvh flex-col">
    <SiteHeader lang={lang} path={path} bilingual={bilingual} wide={wide} />
    <div id="site-notice" hidden class="border-b border-teal-200 bg-teal-50 px-4 py-2 text-center text-sm text-teal-900"></div>
    <main class:list={["mx-auto w-full flex-1 px-4 py-8 sm:px-6", wide ? "max-w-6xl" : "max-w-3xl"]}>
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <script is:inline>
      fetch('/api/v1/site-config').then(response => response.ok ? response.json() : null).then(config => {
        const notice = document.getElementById('site-notice');
        if (notice && config?.notice) { notice.textContent = config.notice; notice.hidden = false; }
      }).catch(() => {});
    </script>
    {entryChecks && <script is:inline set:html={entryCheckScript} />}
    {entryChecks && <script is:inline set:html={entryStreamScript} />}
  </body>
</html>
